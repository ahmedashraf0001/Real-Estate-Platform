# Environment variables for Zakaria Farid Real Estate
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it contains secrets.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Your Supabase project URL (safe to expose — scoped by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/publishable key (safe to expose client-side)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase service role key — SERVER SIDE ONLY.
# NEVER prefix with NEXT_PUBLIC_. Never reference in client-bundled code.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ─── Contact / Lead routing ───────────────────────────────────────────────────
# Zakaria's WhatsApp number (digits only, including country code, no + or spaces).
# Example: 201009970776 (Egypt +20 10 099 70776)
NEXT_PUBLIC_WHATSAPP_NUMBER=201009970776

# ─── Maintenance mode ─────────────────────────────────────────────────────────
# Set to 'true' to take the public site into maintenance mode.
# The admin dashboard (/admin) and all API routes remain fully accessible.
# Default: false (or unset — maintenance mode is OFF by default).
# In production: toggle this in Cloudflare Pages dashboard →
#   Settings → Environment Variables → Production → MAINTENANCE_MODE
MAINTENANCE_MODE=false
